# Athorize configuration — copy to backend/.env and edit. On a server make it
# root:athorize, mode 640 (docs/INSTALL.md §5); on a laptop, mode 600.
# Every key here can also be set as an environment variable (env wins).
# Full reference: docs/INSTALL.md §5.

# Secrets. If left unset, Athorize generates both on first start and saves them
# to <DATA_DIR>/secrets.env (mode 600). Set them here to keep key material out
# of the data directory. Generate with: openssl rand -hex 32
#SECRET_KEY=
#ATHORIZE_AUDIT_HMAC_KEY=

# Data location. The database is <DATA_DIR>/data.db; evidence and backups
# default to <DATA_DIR>/evidence and <DATA_DIR>/backups.
DATA_DIR=~/.athorize-universal
#EVIDENCE_DIR=~/.athorize-universal/evidence
#BACKUP_DIR=~/.athorize-universal/backups
# Retention in BACKUP_DIR: newest completed backups / restore rollback copies kept (0 = keep all)
ATHORIZE_BACKUP_KEEP=10
ATHORIZE_BACKUP_KEEP_ROLLBACKS=3

# Comma-separated browser origins allowed to call the API cross-origin
# (only needed when the UI is served from a different origin, e.g. Vite dev).
CORS_ORIGINS=http://localhost:3000

# Set to 1 only behind a TLS-terminating reverse proxy that sets X-Forwarded-Proto.
#ATHORIZE_TRUST_XFF=1

DEBUG=false
